[Unit]
Description=Wallet daily Telegram health summary
After=network-online.target
Wants=network-online.target
OnFailure=wallet-monitor-failure.service

[Service]
Type=oneshot
EnvironmentFile=/etc/surprising-wallet-monitor/monitor.env
ExecStart=/usr/bin/python3 /usr/local/libexec/wallet-monitor.py --summary
StateDirectory=surprising-wallet-monitor
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=90
MemoryMax=128M
CPUQuota=20%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/surprising-wallet-monitor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
