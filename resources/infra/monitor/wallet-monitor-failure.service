[Unit]
Description=Report wallet monitoring process failure
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/surprising-wallet-monitor/monitor.env
ExecStart=/usr/bin/python3 /usr/local/libexec/wallet-monitor.py --failure-notification
TimeoutStartSec=15
MemoryMax=64M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=surprising-wallet-monitor
StateDirectoryMode=0700
ReadWritePaths=/var/lib/surprising-wallet-monitor
UMask=0077
