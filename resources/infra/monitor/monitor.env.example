# Install as /etc/surprising-wallet-monitor/monitor.env (root:root, mode 0600).
# Do not commit a filled copy. Use the existing monitoring bot and destination.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME
WALLET_MONITOR_LABEL=wallet-host
WALLET_MONITOR_PUBLIC_URL=https://wallet.example.com/actuator/health
# Optional Telegram forum topic:
# TELEGRAM_MESSAGE_THREAD_ID=123
