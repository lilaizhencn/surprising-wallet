[Unit]
Description=Surprising Wallet Signature Service 1
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=wallet
Group=wallet
WorkingDirectory=/opt/surprising-wallet
EnvironmentFile=/etc/surprising-wallet/sig1.env
ExecStart=/usr/bin/java -Xms256m -Xmx1g -XX:+ExitOnOutOfMemoryError -jar /opt/surprising-wallet-backend/current/wallet-server.jar --sw.wallet.mode=sig1
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/surprising-wallet/logs

[Install]
WantedBy=multi-user.target
