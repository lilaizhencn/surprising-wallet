[Unit]
Description=Surprising Wallet API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wallet
Group=wallet
WorkingDirectory=/opt/surprising-wallet
EnvironmentFile=/etc/surprising-wallet/wallet.env
ExecStart=/usr/bin/java -Xms128m -Xmx640m -XX:MaxDirectMemorySize=128m -XX:ReservedCodeCacheSize=96m -XX:+ExitOnOutOfMemoryError -jar /opt/surprising-wallet-backend/current/wallet-server.jar
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=90
KillMode=process
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/surprising-wallet/logs

[Install]
WantedBy=multi-user.target
