[Unit]
Description=Surprising Wallet Tenant Demo Continuous Recharge
After=tenant-demo.service surprising-wallet.service
Requires=tenant-demo.service

[Service]
Type=simple
User=wallet
Group=wallet
WorkingDirectory=/opt/surprising-wallet/resources/tenant-demo
EnvironmentFile=/etc/surprising-wallet/tenant-demo-recharge.env
ExecStart=/usr/bin/node scripts/continuous-recharge.js
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/tenant-demo
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
